{
  "name": "authclear",
  "version": "0.1.0",
  "private": false,
  "description": "Explain a prior-authorization FHIR resource in plain language and export the next action as a FHIR Task.",
  "license": "MIT",
  "author": "Igor Eduardo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate": "tsx scripts/generate-corpus.ts",
    "eval": "tsx scripts/run-eval.ts",
    "validate:hl7": "node scripts/validate-hl7.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "text-readability": "^1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
